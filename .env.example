# Chaves aceitas pelo provider-fake. Não são segredos reais: só funcionam contra ele.
# Recebidas pelo provider-fake e pelo gateway (e pela app só enquanto F2–F4 ainda
# chamam os providers direto; ao fim da refatoração a app deixa de recebê-las).
FAKE_OPENAI_KEY=sk-fake-openai-0001
FAKE_ANTHROPIC_KEY=sk-ant-fake-0001

# AI Gateway (LiteLLM). A master key administra o gateway e fica só no serviço gateway;
# precisa começar com "sk-".
LITELLM_MASTER_KEY=sk-gateway-master-0001
# Chave virtual da app (alias helpdesk-app), criada pelo gateway/provision_keys.py.
GATEWAY_APP_KEY=sk-helpdesk-app-0001
# Senha do Postgres do gateway (gateway-db).
GATEWAY_DB_PASSWORD=gateway-db-0001
